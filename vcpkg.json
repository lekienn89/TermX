{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "termx",
  "version-semver": "0.1.0",
  "description": "TermX - SSH / Telnet / Serial terminal for Windows 10 and 11",
  "builtin-baseline": "5d4a3dc90c0b3773f3bac81bf41297b54328f471",
  "dependencies": [
    {
      "name": "libssh2",
      "default-features": false,
      "features": [ "openssl", "zlib" ]
    },
    {
      "name": "sqlite3",
      "features": [ "fts5" ]
    }
  ]
}
