<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for TermX releases (slug: release-bundle).
  Paste this into SignPath > Project "termx" > Artifact configurations.
  The CI artifact is the zip made by actions/upload-artifact, holding the MSI and
  the portable zip. Only TermX's own binaries are signed: TermX.exe and the MSI.
  Third-party DLLs pass through unchanged, as the SignPath Foundation terms require.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <msi-file path="TermX-*-x64.msi">
      <pe-file path="TermX.exe" product-name="TermX" product-version="${version}">
        <authenticode-sign />
      </pe-file>
      <authenticode-sign />
    </msi-file>
    <zip-file path="TermX-*-x64-portable.zip">
      <pe-file path="TermX/TermX.exe" product-name="TermX" product-version="${version}">
        <authenticode-sign />
      </pe-file>
    </zip-file>
  </zip-file>
</artifact-configuration>
