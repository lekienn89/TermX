<?xml version="1.0" encoding="utf-8"?>
<!--
  TermX MSI (WiX Toolset v5).
  Build (from the repository root, after packaging to dist\TermX):
    wix extension add -g WixToolset.UI.wixext/5.0.2
    wix build installer\TermX.wxs -arch x64 -ext WixToolset.UI.wixext ^
      -d Version=1.0.1 -d RepoDir=%CD% -d DistDir=%CD%\dist\TermX -o TermX-1.0.1-x64.msi
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="TermX"
           Manufacturer="TermX Project"
           Version="$(Version)"
           UpgradeCode="60514073-757e-41bf-b174-bf34a323453c"
           Scope="perMachine"
           Compressed="yes"
           InstallerVersion="500">
    <SummaryInformation Description="TermX $(Version) - SSH, Telnet and serial terminal" />

    <!-- Installing a newer version replaces the old one; settings in %LOCALAPPDATA% are kept. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Windows 10 1809 (build 17763) or later: ConPTY needs it. -->
    <Property Id="WINBUILD">
      <RegistrySearch Id="WinBuild" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" />
    </Property>
    <Launch Condition="Installed OR (WINBUILD &gt;= 17763)"
            Message="TermX requires Windows 10 version 1809 or later." />

    <Icon Id="TermXIcon" SourceFile="$(RepoDir)\resources\icons\termx.ico" />
    <Property Id="ARPPRODUCTICON" Value="TermXIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/lekienn89/TermX" />
    <Property Id="ARPHELPLINK" Value="https://github.com/lekienn89/TermX/issues" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TermX">
        <Files Include="$(DistDir)\**" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="TermXStartMenu" Name="TermX" Description="SSH, Telnet and serial terminal"
                  Target="[INSTALLFOLDER]TermX.exe" WorkingDirectory="INSTALLFOLDER" Icon="TermXIcon" />
        <RegistryValue Root="HKLM" Key="Software\TermX\Installer" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Condition="INSTALLDESKTOPSHORTCUT = 1">
        <Shortcut Id="TermXDesktop" Name="TermX" Target="[INSTALLFOLDER]TermX.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="TermXIcon" />
        <RegistryValue Root="HKLM" Key="Software\TermX\Installer" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

    <!-- Launch TermX from the last page of the installer. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch TermX" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <CustomAction Id="LaunchTermX" Directory="INSTALLFOLDER" ExeCommand="[INSTALLFOLDER]TermX.exe"
                  Return="asyncNoWait" Impersonate="yes" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchTermX"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <WixVariable Id="WixUILicenseRtf" Value="$(RepoDir)\installer\license.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="$(RepoDir)\installer\dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(RepoDir)\installer\banner.bmp" />
  </Package>
</Wix>
